# Environment Variables Example for SignBridge AI
PROJECT_NAME="SignBridge AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration
DATABASE_URL="sqlite:///./backend/signbridge.db"

# Server Ports
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Upload Constraints
MAX_UPLOAD_SIZE_MB=15

