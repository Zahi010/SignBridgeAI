# SignBridge AI - Pre-Pilot Production Configuration (Phase 6)
PROJECT_NAME="SignBridge AI"
SIGNBRIDGE_ENV="production"
SIGNBRIDGE_DEBUG=False
API_V1_PREFIX="/api/v1"

# Cryptographic Security & Authentication
# Mandatory: replace with a cryptographically secure key (e.g. openssl rand -hex 32)
SIGNBRIDGE_SECRET_KEY="replace_with_strong_crypto_random_secret_at_least_32_chars_long"
SIGNBRIDGE_TOKEN_EXP_SECONDS=604800
SIGNBRIDGE_RATE_LIMIT=120

# Database Configuration
SIGNBRIDGE_DATABASE_URL="sqlite:///./backend/signbridge.db"

# Host & Networking
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://signbridge.ai"

# Storage & Upload Constraints
MAX_UPLOAD_SIZE_MB=15

# Governance & Safeguards
ZERO_FABRICATION_POLICY="strictly_enforced"
